{
  "name": "project-librarian",
  "version": "0.6.5",
  "description": "Create and maintain compact project context for humans and LLM coding agents.",
  "license": "MIT",
  "type": "commonjs",
  "keywords": [
    "agents",
    "claude-code",
    "codex",
    "cursor",
    "gemini",
    "llm",
    "project-planning",
    "wiki"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkjk1176/project-librarian.git"
  },
  "bugs": {
    "url": "https://github.com/kkjk1176/project-librarian/issues"
  },
  "homepage": "https://github.com/kkjk1176/project-librarian#readme",
  "files": [
    "agents/",
    "CONTRIBUTING.md",
    "docs/",
    "dist/",
    "LICENSE",
    "README.md",
    "README.ko.md",
    "SKILL.md"
  ],
  "bin": {
    "project-librarian": "dist/init-project-wiki.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && chmod +x dist/init-project-wiki.js",
    "postbuild": "node tools/project-librarian/sync-installed-skills.js",
    "audit:supply-chain": "npm audit --omit=dev",
    "typecheck": "tsc --noEmit",
    "typecheck:ts7": "npx --yes -p typescript@rc tsc --noEmit --project tsconfig.json",
    "unit": "node --test tests/unit/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=dist/**/*.js --test-coverage-lines=65 --test-coverage-branches=65 --test-coverage-functions=65 tests/unit/*.test.js",
    "test": "npm run build && npm run typecheck && npm run unit && bash tests/smoke.sh",
    "test:installed-skills": "node --test tests/unit/installed-skill-runtime-v2.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.0"
  }
}
